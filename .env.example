PORT=3000
HOST=127.0.0.1

# Tavily Search API
TAVILY_API_KEY=tvly-your-key
TAVILY_MAX_RESULTS=5

# Pinecone index with integrated embedding enabled.
# PINECONE_TEXT_FIELD must match the index field_map text field.
PINECONE_API_KEY=pcsk-your-key
PINECONE_HOST=https://your-index-host
PINECONE_NAMESPACE=rag-dashboard-resources
PINECONE_TEXT_FIELD=text
PINECONE_API_VERSION=2026-04
