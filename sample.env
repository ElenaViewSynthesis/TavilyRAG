PORT=3000
HOST=127.0.0.1

# LLM and embedding provider. Defaults assume OpenAI-compatible APIs.
OPENAI_API_KEY=sk-your-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Tavily Search API
TAVILY_API_KEY=tvly-your-key
TAVILY_MAX_RESULTS=5

# Pinecone data-plane host for an existing dense-vector index.
# Example: https://your-index-abc123.svc.aped-4627-b74a.pinecone.io
# If using text-embedding-3-small, create the index with dimension 1536.
PINECONE_API_KEY=pcsk-your-key
PINECONE_HOST=https://your-index-host
PINECONE_NAMESPACE=rag-dashboard
PINECONE_TOP_K=5
PINECONE_API_VERSION=2026-04
